# ============================================================
# WA Automation Server — Template Environment Variables
# ============================================================
# Salin file ini menjadi .env lalu isi nilainya:
#   copy .env.example .env
#
# File .env TIDAK boleh di-commit ke Git (sudah ada di .gitignore)
# ============================================================

# ----------------------------------------------------------
# SUPABASE (WAJIB)
# ----------------------------------------------------------
# URL project Supabase kamu
# Contoh: https://xyzxyzxyz.supabase.co
# Ambil dari: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Service Role Key (bukan anon key!) — butuh akses penuh ke DB
# Ambil dari: Supabase Dashboard > Project Settings > API > service_role secret
# ⚠️  JAGA KERAHASIAAN KEY INI — jangan pernah di-share atau di-commit
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ----------------------------------------------------------
# BAILEYS LOCAL SERVER (WAJIB)
# ----------------------------------------------------------
# URL Node.js server (repo WA automation) yang menangani koneksi WhatsApp
# Harus sudah berjalan sebelum blast_worker.py dijalankan
# Default: http://localhost:4000 (sesuai wa-client.js di repo WA automation)
BAILEYS_LOCAL_URL=http://localhost:4000

# ----------------------------------------------------------
# OPSIONAL
# ----------------------------------------------------------
# Folder output untuk file gambar screenshot sementara (PNG dari range Excel)
# Default: folder temp OS (C:\Users\<user>\AppData\Local\Temp)
# REPORT_OUTPUT_DIR=C:\WA-Reports

# Timeout (detik) menunggu Excel membuka file SharePoint/OneDrive
# Naikkan jika koneksi internet lambat atau file besar
# Default: 45
# EXCEL_OPEN_TIMEOUT_SEC=45

# HANYA UNTUK TESTING — paksa semua job active jalan tanpa cek jam/tanggal
# Set ke 1 saat debugging, JANGAN aktifkan di production
# Default: 0
# FORCE_RUN_ALL=0

